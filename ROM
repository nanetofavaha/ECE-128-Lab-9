module ROM(
    input[2:0] addr,
    output reg[3:0] data
);

always@(addr) begin
    case(addr)
        3'd0: data= 4'b0101;
        3'd1: data= 4'b1001;
        3'd2: data= 4'b0110;
        3'd3: data= 4'b0001;
        3'd4: data= 4'b1101;
        3'd5: data= 4'b0001;
        3'd6: data= 4'b0100;
        3'd7: data= 4'b0111;
        endcase
    end
endmodule
